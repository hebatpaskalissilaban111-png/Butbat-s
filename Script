-- 2. FUNGSI ELEMENT UI
local function createToggle(name, default, callback)
    local active = default
    local btn = Instance.new("TextButton", container)
    btn.Text = name .. ": " .. (active and "ON" or "OFF")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = active and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamSemibold
    Instance.new("UICorner", btn)
    
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = name .. ": " .. (active and "ON" or "OFF")
        btn.BackgroundColor3 = active and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(40, 40, 40)
        callback(active)
    end)
end

-- 3. FITUR LOGIC
local settings = {fly = false, noclip = false, esp = false, aim = false, speed = 2}

createToggle("FLY (WASD)", false, function(v) settings.fly = v p.Character.Humanoid.PlatformStand = v end)
createToggle("NOCLIP", false, function(v) settings.noclip = v end)
createToggle("PLAYER ESP", false, function(v) settings.esp = v end)
createToggle("SILENT AIM", false, function(v) settings.aim = v end)

-- Speed Slider-like Button
local speedBtn = Instance.new("TextButton", container)
speedBtn.Text = "FLY SPEED: " .. settings.speed
speedBtn.Size = UDim2.new(1, 0, 0, 35)
speedBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
speedBtn.TextColor3 = Color3.new(1, 1, 1)
Instance.new("UICorner", speedBtn)
speedBtn.MouseButton1Click:Connect(function()
    settings.speed = (settings.speed >= 10) and 2 or settings.speed + 2
    speedBtn.Text = "FLY SPEED: " .. settings.speed
end)

-- 4. CORE LOOP (RUNSERVICE)
uis.InputBegan:Connect(function(i, g) if not g and i.KeyCode == Enum.KeyCode.P then main.Visible = not main.Visible end end)

rs.RenderStepped:Connect(function()
    local c = p.Character
    if not c or not c:FindFirstChild("HumanoidRootPart") then return end
    local hrp = c.HumanoidRootPart

    if settings.fly then
        hrp.Velocity = Vector3.new(0, 0.1, 0)
        local dir = Vector3.new(0,0,0)
        if uis:IsKeyDown("W") then dir += cam.CFrame.LookVector end
        if uis:IsKeyDown("S") then dir -= cam.CFrame.LookVector end
        if uis:IsKeyDown("A") then dir -= cam.CFrame.RightVector end
        if uis:IsKeyDown("D") then dir += cam.CFrame.RightVector end
        hrp.CFrame = hrp.CFrame + (dir * settings.speed)
        
        if settings.noclip then
            for _, v in pairs(c:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
        end
    end

    if settings.esp or settings.aim then
        for _, other in pairs(game.Players:GetPlayers()) do
            if other ~= p and other.Character then
                -- ESP
                local hl = other.Character:FindFirstChild("AdminHighlight")
                if settings.esp then
                    if not hl then hl = Instance.new("Highlight", other.Character) hl.Name = "AdminHighlight" end
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.DepthMode = 0
                elseif hl then hl:Destroy() end
                
                -- Silent Aim
                if settings.aim and uis:IsMouseButtonPressed(2) then
                    local head = other.Character:FindFirstChild("Head")
                    if head then
                        local _, vis = cam:WorldToViewportPoint(head.Position)
                        if vis then cam.CFrame = CFrame.new(cam.CFrame.Position, head.Position) end
                    end
                end
            end
        end
    end
end)
